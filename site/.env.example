# Site vitrine Riiberaka — variables publiques (lues à la compilation).
# Ne JAMAIS mettre de secret dans une variable NEXT_PUBLIC_*.
# Une variable vide masque l'élément concerné : rien n'est inventé.

# Côté serveur Next uniquement : origine du backend NestJS (sans /api/v1).
BACKEND_URL=http://localhost:4000

# Domaine définitif du site. Tant qu'il est vide : noindex, sitemap vide.
NEXT_PUBLIC_SITE_URL=

# Destination du bouton « Commander » (la première renseignée est utilisée).
NEXT_PUBLIC_CLIENT_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# Lien « Déjà partenaire ? » vers l'espace des restaurants.
NEXT_PUBLIC_RESTAURANT_APP_URL=

# Coordonnées affichées (pied de page, secours du formulaire).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Réseaux sociaux (affichés seulement s'ils sont renseignés).
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Mentions légales (sinon : « À compléter avant la mise en ligne »).
NEXT_PUBLIC_LEGAL_PUBLISHER=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_HOST=
