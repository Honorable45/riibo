# Riiberaka — variables d'environnement du backend.
# Copiez ce fichier en `.env` et remplacez CHAQUE valeur d'exemple. Le serveur
# refuse de démarrer si un secret JWT est absent, trop court (< 32 caractères),
# identique à un autre, ou égal à une valeur d'exemple (voir
# src/config/startup-validation.ts). Générez-les avec : openssl rand -hex 32

# --- Base de données (Neon en production) ---
# DATABASE_URL : connexion (poolée) utilisée par l'application.
# DIRECT_URL   : connexion directe, utilisée uniquement par `prisma migrate`
#                (Neon : l'hôte SANS "-pooler"). Facultative en local.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/riiberaka?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/riiberaka?sslmode=require"
# SHADOW_DATABASE_URL : base vide jetable, seulement pour `prisma migrate diff/dev` en local.

# --- Serveur ---
PORT=4000
NODE_ENV=development
# Nombre de proxys de confiance devant l'API (pour l'IP réelle du client : limitation de débit, journaux).
# Production Vercel → Render : 2. Local : 0.
TRUST_PROXY_HOPS=0
# Origines des PWA autorisées (client, restaurant, livreur, admin), séparées par des virgules.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# --- JWT (trois secrets DISTINCTS) ---
JWT_ACCESS_SECRET="REMPLACER-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="REMPLACER-openssl-rand-hex-32"
JWT_REFRESH_EXPIRES_IN="60d"
# Jeton du bouton « Refuser » d'une notification push d'appel entrant.
CALL_ACTION_JWT_SECRET="REMPLACER-openssl-rand-hex-32"

# --- Redis (OBLIGATOIRE en production) ---
# Présence, temps réel multi-instances (adaptateur Socket.IO), verrous.
# Sans REDIS_URL en développement : repli mémoire, une seule instance.
REDIS_URL="redis://localhost:6379"

# --- Médias : Cloudinary (photos, logos, plats, avatars, images de chat) ---
# OBLIGATOIRE en production (le serveur refuse de démarrer sans les 3 variables).
# Sans ces 3 variables : images sur disque local (STORAGE_LOCAL_PATH). Cloudinary héberge aussi les
# vocaux et les pièces privées (accès signé). Le disque local ne sert qu'en développement.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"

# --- Comptes ---
# Email transactionnel (réinitialisation de mot de passe). "none" : le lien est journalisé.
MAIL_PROVIDER="none"
# MAIL_API_KEY=
# SMS (OTP). "none" : le code est journalisé (développement uniquement).
SMS_PROVIDER="none"
# ZAVUDEV_API_KEY=
# ZAVU_SENDER=
# Vérification OTP du téléphone à l'inscription. En production le serveur exige
# "true" avec un vrai SMS_PROVIDER, sauf dérogation explicite ci-dessous.
REGISTRATION_OTP_ENABLED="false"
# ALLOW_UNVERIFIED_PHONE_REGISTRATION="true"

# --- Paiement (voir ARCHITECTURE.md §10) ---
# PAYMENT_PROVIDER="cash"        # cash | sandbox | <fournisseur mobile money>
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- Notifications push ---
# Web Push (PWA) : générer une fois avec `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:contact@riiberaka.com"
# Hôtes de push supplémentaires acceptés (en plus de Google, Mozilla, Apple, Windows) — rarement utile.
# PUSH_ENDPOINT_ALLOWED_HOSTS=
# FCM (facultatif — futur client mobile natif). Contenu JSON du compte de service, sur une ligne.
# FIREBASE_SERVICE_ACCOUNT=

# --- Appels audio/vidéo (WebRTC) ---
# STUN_URLS="stun:stun.l.google.com:19302"
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Seed (jamais en production pour SEED_DEMO) ---
# SEED_ADMIN_PHONE="+228XXXXXXXX"
# SEED_ADMIN_PASSWORD="REMPLACER"
# SEED_DEMO="true"
